<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SYOS System</display-name>
    <servlet>
        <servlet-name>BillingServlet</servlet-name>
        <servlet-class>com.syos.presentation.BillingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillingServlet</servlet-name>
        <url-pattern>/api/billing/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InventoryServlet</servlet-name>
        <servlet-class>com.syos.presentation.InventoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InventoryServlet</servlet-name>
        <url-pattern>/api/inventory/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OnlineStoreServlet</servlet-name>
        <servlet-class>com.syos.presentation.OnlineStoreServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OnlineStoreServlet</servlet-name>
        <url-pattern>/api/store/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.syos.presentation.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/api/reports/*</url-pattern>
    </servlet-mapping>

</web-app>